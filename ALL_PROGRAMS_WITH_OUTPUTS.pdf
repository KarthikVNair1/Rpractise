(PROGRAM 2: PALINDROME CHECKER) Tj
0 -30 Td
/F1 10 Tf
(Code:) Tj
0 -15 Td
(palin <- function(num) {) Tj
0 -12 Td
(  original <- num) Tj
0 -12 Td
(  reversed <- 0) Tj
0 -12 Td
(  while (num > 0) {) Tj
0 -12 Td
(    digit <- num %% 10) Tj
0 -12 Td
(    reversed <- (reversed * 10) + digit) Tj
0 -12 Td
(    num <- num %/% 10) Tj
0 -12 Td
(  }) Tj
0 -12 Td
(  if (original == reversed) {) Tj
0 -12 Td
(    cat("It is a palindrome\\n")) Tj
0 -12 Td
(  } else {) Tj
0 -12 Td
(    cat("It is not a palindrome\\n")) Tj
0 -12 Td
(  }) Tj
0 -12 Td
(}) Tj
0 -12 Td
() Tj
0 -12 Td
